# Required — every model call is routed through OpenRouter
PLANTOPIA_OPENROUTER_API_KEY=sk-or-v1-your-key-here

# Optional — enables the web-search escalation tool
PLANTOPIA_TAVILY_API_KEY=

# Optional — enables the second species identification, by Pl@ntNet.
# Free tier: 500 identifications/day, commercial use permitted, European hosting. Register
# at my.plantnet.org. Without it the diagnosis runs on the vision model's identification
# alone, exactly as it did before the service existed, and nothing in the interface offers
# or mentions it.
#
# Showing a Pl@ntNet result obliges you to credit Pl@ntNet on the same surface. That is a
# term of the free tier, not a courtesy, and the interface does it for you.
PLANTOPIA_PLANTNET_API_KEY=

# One Postgres holds the domain records, the disorder corpus as vectors, and both
# graph checkpointers. The default below matches docker-compose.yml, so a fresh
# clone running `docker compose up -d db` needs no entry here at all. The port is
# 5433, not 5432: a machine with its own PostgreSQL service already holds 5432, and
# the collision surfaces as an authentication failure from a healthy container.
#
# Name the driver. SQLAlchemy still reads a bare `postgresql://` as psycopg2, which
# this project does not install, and the resulting ImportError never mentions the URL.
# PLANTOPIA_DATABASE_URL=postgresql+psycopg://plantopia:plantopia@localhost:5433/plantopia

# Model tiers (defaults shown). Every slug below was verified reachable AND
# tool-calling on a restricted college-issued OpenRouter key. Re-verify before
# changing any of them — see "Checking what your key can reach" in the README.
# gate    — the two binary image checks; runs on every diagnosis, so keep it cheap
# vision  — species identification and symptom extraction; needs real visual acuity
# reasoning — question selection, diagnosis, treatment plan; text only, needs judgement
# PLANTOPIA_GATE_MODEL=google/gemini-2.5-flash-lite
# PLANTOPIA_VISION_MODEL=google/gemini-2.5-flash
# PLANTOPIA_REASONING_MODEL=openai/gpt-4o

# Upgrades worth trying IF your OpenRouter account's data policy allows them. On
# restricted keys these return 404 "No endpoints available matching your guardrail
# restrictions and data policy" — that is an account setting, not a bad slug.
# PLANTOPIA_REASONING_MODEL=anthropic/claude-sonnet-4.5
# PLANTOPIA_REASONING_MODEL=google/gemini-2.5-pro
# PLANTOPIA_REASONING_MODEL=openai/gpt-4.1

# Retrieval embeddings, via OpenRouter's /embeddings endpoint.
# Verified working: openai/text-embedding-3-small (1536 dims),
# openai/text-embedding-3-large (3072), qwen3-embedding-8b (4096).
# PLANTOPIA_EMBEDDING_MODEL=openai/text-embedding-3-small

# Cross-modal retrieval: embed the photograph itself and search the same corpus,
# bypassing the written symptom description (spec §10.4). Needs an embedding model
# that accepts image input — the OpenAI ones refuse outright, and gemini-embedding-001
# (the only reachable candidate) is data-policy blocked on restricted keys. Set BOTH
# of these together to light the path up; no code change needed.
# PLANTOPIA_EMBEDDING_MODEL=gemini-embedding-001
# PLANTOPIA_MULTIMODAL_EMBEDDINGS=true

# Where the web client is served. Every link in a verification or password-reset email is
# built from this, so a wrong value is a link nobody can follow and nobody can be told
# about — it pointed at Streamlit's retired port for a while, which is exactly that.
# Also sent to OpenRouter for attribution, where it shows up on your dashboard.
# PLANTOPIA_APP_URL=http://localhost:5173
# PLANTOPIA_APP_TITLE=Plantopia

# The HTTP API. Every route is served beneath the prefix; a later incompatible
# version can then exist alongside this one rather than replacing it underneath a
# running client.
# PLANTOPIA_API_PREFIX=/api/v1

# Origins allowed to call the API from a browser, comma-separated. Empty means none,
# which is correct until a frontend exists. Never "*": a permissive default is the
# kind of thing that ships because nobody had a reason to tighten it.
# PLANTOPIA_CORS_ORIGINS=http://localhost:5173

# REQUIRED — signs access tokens. There is no default on purpose: a generated one
# would work perfectly here and log everybody out at random in production, because
# every restart would invalidate every token issued before it.
# Generate with:  python -c "import secrets; print(secrets.token_urlsafe(48))"
PLANTOPIA_JWT_SECRET=

# Session lifetimes. The access token cannot be revoked — it is believed until it
# expires — so its life is the window a stolen one is useful for. The refresh token
# can be revoked, which is why it may live longer.
# PLANTOPIA_ACCESS_TOKEN_MINUTES=15
# PLANTOPIA_REFRESH_TOKEN_DAYS=30
# PLANTOPIA_VERIFICATION_TOKEN_HOURS=24
# PLANTOPIA_RESET_TOKEN_HOURS=1
# PLANTOPIA_MINIMUM_PASSWORD_LENGTH=12
# The privacy notice version a registration agrees to. Stored per account, so
# changing this does not rewrite what anybody previously consented to.
# PLANTOPIA_CONSENT_VERSION=2026-08-25
# Whether the refresh cookie is marked Secure. Turn it off only to serve a
# frontend over plain http on localhost — a browser will not send a Secure
# cookie back over http, so the session silently fails to survive a refresh.
# PLANTOPIA_SECURE_COOKIES=true

# Transactional email. Without a key, messages are written to the log rather than
# sent — which is what development and the test suite use.
# PLANTOPIA_RESEND_API_KEY=
# PLANTOPIA_MAIL_FROM=Plantopia <onboarding@resend.dev>

# Spend control. A diagnosis costs roughly five cents, and registration is open, so
# these are not optional in any deployment reachable from the internet.
# PLANTOPIA_MONTHLY_RUN_ALLOWANCE=20
# Per-tier overrides of the allowance above, as JSON. A tier absent from here gets
# the default, so introducing a paid tier is this line rather than a code change.
# PLANTOPIA_TIER_ALLOWANCES={"pro": 500}
# PLANTOPIA_DAILY_SPEND_CAP_USD=5.0
# PLANTOPIA_AUTH_RATE_LIMIT=10
# PLANTOPIA_AUTH_RATE_WINDOW_SECONDS=300

# Background runs. The pool is small because a run waits on a provider rather than
# working: more threads buy queue depth, not throughput. A full queue refuses a run at
# the door rather than piling up work that each takes minutes.
# PLANTOPIA_RUN_POOL_SIZE=4
# PLANTOPIA_RUN_QUEUE_LIMIT=32
# Two ceilings, because waiting for a person is not the same as being stuck. Past the
# first, a run still working is a process that died; past the second, a run waiting for
# answers is somebody who closed the tab.
# PLANTOPIA_RUN_WORKING_CEILING_MINUTES=10
# PLANTOPIA_RUN_ANSWERING_CEILING_MINUTES=60
# How often an idle event stream says something, so a proxy does not close it mid-run.
# PLANTOPIA_RUN_KEEPALIVE_SECONDS=15
# Whether this process ends runs that stopped responding. One process should; several
# would each sweep, which is wasteful rather than wrong.
# PLANTOPIA_RUN_SWEEPER_ENABLED=true
# PLANTOPIA_RUN_SWEEPER_INTERVAL_SECONDS=60

# Where the evaluation harness writes its results and the API reads the newest one
# from. One setting for both, so they cannot drift into different directories.
# PLANTOPIA_EVAL_RESULTS_PATH=eval/results

# Behaviour thresholds
# PLANTOPIA_RETRIEVAL_SCORE_THRESHOLD=0.35
# PLANTOPIA_SPECIES_CONFIDENCE_THRESHOLD=0.50
# PLANTOPIA_DIAGNOSIS_CONFIDENCE_THRESHOLD=0.35
# PLANTOPIA_MAX_CLARIFYING_QUESTIONS=4

# Optional — enables LangSmith tracing. Without it the app runs unchanged and
# tracing is simply off. Free Developer tier is ample for this project.
# PLANTOPIA_LANGSMITH_API_KEY=
# PLANTOPIA_LANGSMITH_PROJECT=plantopia

# LangSmith API keys are region-scoped. Leave this unset unless your workspace
# is on a non-default region/host — an EU-workspace key 403s against the
# default US endpoint, and tracing will silently upload nowhere.
# PLANTOPIA_LANGSMITH_ENDPOINT=https://eu.api.smith.langchain.com
