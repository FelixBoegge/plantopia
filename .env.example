# Required — every model call is routed through OpenRouter
PLANTOPIA_OPENROUTER_API_KEY=sk-or-v1-your-key-here

# Optional — enables the web-search escalation tool
PLANTOPIA_TAVILY_API_KEY=

# Model tiers (defaults shown). Every slug below was verified reachable AND
# tool-calling on a restricted college-issued OpenRouter key. Re-verify before
# changing any of them — see "Checking what your key can reach" in the README.
# gate    — the two binary image checks; runs on every diagnosis, so keep it cheap
# vision  — species identification and symptom extraction; needs real visual acuity
# reasoning — question selection, diagnosis, treatment plan; text only, needs judgement
# PLANTOPIA_GATE_MODEL=google/gemini-2.5-flash-lite
# PLANTOPIA_VISION_MODEL=google/gemini-2.5-flash
# PLANTOPIA_REASONING_MODEL=openai/gpt-4o

# Upgrades worth trying IF your OpenRouter account's data policy allows them. On
# restricted keys these return 404 "No endpoints available matching your guardrail
# restrictions and data policy" — that is an account setting, not a bad slug.
# PLANTOPIA_REASONING_MODEL=anthropic/claude-sonnet-4.5
# PLANTOPIA_REASONING_MODEL=google/gemini-2.5-pro
# PLANTOPIA_REASONING_MODEL=openai/gpt-4.1

# Retrieval embeddings, via OpenRouter's /embeddings endpoint.
# Verified working: openai/text-embedding-3-small (1536 dims),
# openai/text-embedding-3-large (3072), qwen3-embedding-8b (4096).
# PLANTOPIA_EMBEDDING_MODEL=openai/text-embedding-3-small

# Cross-modal retrieval: embed the photograph itself and search the same corpus,
# bypassing the written symptom description (spec §10.4). Needs an embedding model
# that accepts image input — the OpenAI ones refuse outright, and gemini-embedding-001
# (the only reachable candidate) is data-policy blocked on restricted keys. Set BOTH
# of these together to light the path up; no code change needed.
# PLANTOPIA_EMBEDDING_MODEL=gemini-embedding-001
# PLANTOPIA_MULTIMODAL_EMBEDDINGS=true

# Sent to OpenRouter for attribution; shows up on your dashboard
# PLANTOPIA_APP_URL=http://localhost:8501
# PLANTOPIA_APP_TITLE=Plantopia

# Behaviour thresholds
# PLANTOPIA_RETRIEVAL_SCORE_THRESHOLD=0.35
# PLANTOPIA_SPECIES_CONFIDENCE_THRESHOLD=0.50
# PLANTOPIA_DIAGNOSIS_CONFIDENCE_THRESHOLD=0.35
# PLANTOPIA_MAX_CLARIFYING_QUESTIONS=4

# Optional — enables LangSmith tracing. Without it the app runs unchanged and
# tracing is simply off. Free Developer tier is ample for this project.
# PLANTOPIA_LANGSMITH_API_KEY=
# PLANTOPIA_LANGSMITH_PROJECT=plantopia

# LangSmith API keys are region-scoped. Leave this unset unless your workspace
# is on a non-default region/host — an EU-workspace key 403s against the
# default US endpoint, and tracing will silently upload nowhere.
# PLANTOPIA_LANGSMITH_ENDPOINT=https://eu.api.smith.langchain.com
