data/plantopia.db
# LangGraph's checkpointer opens its own SQLite file alongside the main one, plus the
# usual -shm/-wal sidecars once WAL mode kicks in. The chat agent's checkpointer opens
# a second, separate one.
data/plantopia.db.checkpoints*
data/plantopia.db.chat-checkpoints*
# numbers while the parity gate runs. Local scratch: a deployment embeds the corpus
# itself (`python -m knowledge.ingest_corpus`), and the committed fixture in
# eval/fixtures/ is what preserves the comparison.
data/uploads/
.playwright-mcp/
.superpowers/

# Local state for `langgraph dev` — the API server's in-memory store, checkpointed
# to disk between restarts. Machine-local scratch, like the uploads directory.
.langgraph_api/

